<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.carelink</groupId>
    <artifactId>carelink-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <!-- Un solo módulo, a propósito. Los dos bounded contexts del sistema
         —Identity y Clinical Records— viven dentro de identity-service, en
         paquetes separados (SRS §3.3). Los sub-dominios clínicos (Patient,
         Encounter, Triage, Diary, Knowledge Engine, Interconsultations, Labs,
         Pharmacy) no se separan en servicios: ocho microservicios para un
         proyecto de un solo desarrollador ya está documentado como error a
         evitar, no como objetivo. -->
    <modules>
        <module>services/identity-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring.boot.version>3.3.0</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
