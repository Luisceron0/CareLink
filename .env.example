# CareLink — plantilla de variables de entorno. Nombres, nunca valores.
# Copiar a `.env` (gitignorado) y completar. SRS §8.5.
#
# Entornos: local (docker-compose) y CI. No hay producción ni demo público
# (ADR-015, §1.6). Ninguna variable de acá describe un despliegue real.

# ── Contención (§1.6, §15.2) ─────────────────────────────────────────────────
# DemoModeGuard hace fallar el arranque si DEMO_MODE no es `true`, si APP_ENV
# parece de producción, o si la base no lleva el sello SYNTHETIC_DATA_ONLY
# (AC-01, AC-02).
DEMO_MODE=true
APP_ENV=local

# ── Base de datos (PostgreSQL 16, schema-per-tenant — ADR-001) ───────────────
# Dos roles, no uno (AC-10). El administrador (POSTGRES_USER/PASSWORD) es
# superusuario del cluster — lo usan Flyway y el provisioning de tenants, nunca
# el tráfico normal de la aplicación. `carelink_app` es el rol restringido que sí
# lo usa: sin permiso de DELETE/UPDATE sobre audit_log, sin permiso de crear ni
# alterar tablas. Lo provisiona docker/postgres-init/01-create-app-role.sh al
# inicializar el volumen de Postgres — no una migración de la aplicación.
POSTGRES_DB=carelink
POSTGRES_USER=carelink
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
CARELINK_APP_DB_USER=carelink_app
CARELINK_APP_DB_PASSWORD=
# El backend la recibe armada por docker-compose; definila solo si corrés el
# backend fuera de compose contra un Postgres propio.
# DATABASE_URL=jdbc:postgresql://localhost:5432/carelink

# ── JWT RS256 + JWKS (ADR-004, §8.5) ────────────────────────────────────────
# El par de claves se genera FUERA del repo. Nunca versionado.
JWT_VAULT_PEM=
JWT_VAULT_PEM_PATH=
JWT_VAULT_KID=
JWT_ACCESS_TTL=900
JWT_JWKS_URL=
# Allowlist de hosts para el fetch de JWKS (separados por coma). Si está vacío,
# no se restringe — definilo si JWT_JWKS_URL apunta afuera.
JWT_JWKS_HOST_ALLOWLIST=
JWT_JWKS_CONNECT_TIMEOUT_MS=5000
JWT_JWKS_READ_TIMEOUT_MS=5000

# ── Refresh tokens (rotación one-time-use, FR-ID-03/FR-ID-04) ───────────────
# Sin valor por defecto a propósito: docker-compose falla si no lo definís.
# El `change-me-in-prod` que vivía acá antes era la clase de default que termina
# desplegado — mismo patrón que el `dev-secret` de ADR-010.
REFRESH_TOKEN_HMAC_SECRET=
REFRESH_TOKEN_TTL_SECONDS=604800
MAX_CONCURRENT_SESSIONS=3

# ── Cifrado de PHI (AES-256-GCM, clave maestra — ADR-003, §8.3) ─────────────
# Deuda conocida y documentada: la clave vive en variable de entorno, no en un
# KMS. Es un punto único de falla, aceptado para este milestone (§8.3).
# 32 bytes en base64: `openssl rand -base64 32`. AesGcmEncryptionService deriva
# de esta una clave distinta por tenant (HMAC-SHA256 sobre el slug) — no es la
# clave que cifra directamente cada columna.
CLINIC_ENCRYPTION_KEY=

# ── Motor de Conocimiento (ADR-007, FR-CLN-07) ──────────────────────────────
# k-anonimato. Umbral server-side, no negociable. Se construye en Sub-fase 4.
KNOWLEDGE_ANONYMITY_THRESHOLD=5

# ── Puertos locales ─────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Correo (verificación de email, FR-ID-02) ────────────────────────────────
# Sin integración SMTP viva en este milestone (§16.4). Apuntar a un catcher
# local (MailHog/Mailpit) o dejar vacío.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ── Fuera del stack — no las repongas sin un ADR nuevo ──────────────────────
# Kafka (Confluent), Redis (Upstash), Supabase y Railway salieron: ADR-012
# (Docker Compose local) y ADR-015 (sin demo público) reemplazan esa
# infraestructura, y §9 es explícito en que nada de §5 los requiere.
