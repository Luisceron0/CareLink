<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.carelink</groupId>
        <artifactId>carelink-parent</artifactId>
        <version>0.1.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>identity-service</artifactId>
    <packaging>jar</packaging>

    <dependencyManagement>
        <dependencies>
            <!-- Fija los binarios de PostgreSQL embebido en la misma versión mayor que
                 corre docker-compose y que declara el SRS §9. Si esto se desalinea, los
                 tests pasan a verificar un motor distinto del que se ejecuta. -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>16.2.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Health checks liveness/readiness (SRS §14). Solo se expone `health`
             (ver application.yml) — no es una consola de administración. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>de.mkammerer</groupId>
            <artifactId>argon2-jvm</artifactId>
            <version>2.11</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Versionado de esquema (SRS §9). Se adopta acá, en Sub-fase 1, antes de
             agregar la primera tabla nueva: migrations/ tenía dos archivos creando
             `tenants` y `users` con formas incompatibles, y ambos con IF NOT EXISTS,
             así que el esquema resultante dependía del orden lexicográfico. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- PostgreSQL embebido para tests de integración (SRS §13).
             Zonky, no otj-pg-embedded de OpenTable: aquel empaquetaba PostgreSQL 10,
             mientras el SRS especifica 16 y docker-compose corre 16. La diferencia no
             era teórica — `gen_random_uuid()` es builtin desde PG 13 y fallaba — y lo
             que se verifica acá son triggers, GRANTs y constraints, comportamiento
             específico del motor. Un test de AC-10 sobre otra versión mayor no
             evidencia AC-10. El §13 decía "Zonky" desde el principio; el código no lo
             cumplía. La versión del binario se fija abajo, en dependencyManagement. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
        <!-- Kafka test utilities (embedded) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <!-- JWT library for RS256 tokens -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.34</version>
        </dependency>
        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot test starter: includes MockMvc, Mockito, Jackson, Hamcrest, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        </dependencies>
        <build>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>21</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                </plugin>
                <!-- Los tests de integración (`*IT`) no los ejecuta surefire, solo
                     failsafe — y failsafe no estaba configurado. Consecuencia:
                     PostgresSchemaProvisionerZonkyIT existía en el repo y nunca se
                     ejecutó, ni con `mvn test` ni con `mvn verify`. Los AC de
                     contención y de auditoría se verifican con tests de integración,
                     así que sin esto no hay forma de evidenciarlos. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.1.2</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <!-- Produce el jar ejecutable que consume el Dockerfile (ADR-012).
                     Sin esto `mvn package` deja un jar plano sin las dependencias
                     y el contenedor no arranca. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring.boot.version}</version>
                    <configuration>
                        <!-- El jar ejecutable sale como artefacto secundario
                             (`-exec.jar`) y el artefacto principal sigue siendo el jar
                             plano. Sin el clasificador, `repackage` reemplaza el
                             principal por el fat jar, cuyas clases viven bajo
                             BOOT-INF/classes; failsafe pone ese jar en el classpath en
                             lugar de target/classes y todo `*IT` muere con
                             ClassNotFoundException sobre clases propias. -->
                        <classifier>exec</classifier>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </build>

</project>
